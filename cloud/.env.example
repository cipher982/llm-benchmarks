# Misc
HF_HUB_CACHE=""
TOKENIZERS_PARALLELISM=False

# Mongo (required)
MONGODB_URI=""
MONGODB_DB=""
MONGODB_COLLECTION_MODELS="models"
MONGODB_COLLECTION_CLOUD=""  # existing metrics collection name

# Mongo (optional collections)
MONGODB_COLLECTION_ERRORS="errors_cloud"
MONGODB_COLLECTION_BENCH_JOBS="bench_jobs"
MONGODB_COLLECTION_MODEL_HEALTH="bench_model_health"
MONGODB_COLLECTION_SCHEDULER_HEARTBEATS="bench_scheduler_heartbeats"

# Scheduler cadence
FRESH_MINUTES=30
SCHEDULER_TICK_SECONDS=30
BENCHMARK_DEADLINE_SECONDS=120
BENCHMARK_MAX_ATTEMPTS=2
BENCHMARK_RETRY_BACKOFF_SECONDS=900
BENCHMARK_RETRY_MAX_BACKOFF_SECONDS=21600
BENCHMARK_DEAD_LETTER_RETRY_AFTER_SECONDS=900
BENCHMARK_BILLING_DEAD_LETTER_RETRY_AFTER_SECONDS=21600
BENCHMARK_LIVENESS_MAX_IDLE_SECONDS=900
BENCHMARK_LIVENESS_STARTUP_GRACE_SECONDS=600
# Comma-separated providers expected to heartbeat on the clifford runner (openrouter).
BENCHMARK_LIVENESS_PROVIDERS="openai,anthropic,vertex,anyscale,together,fireworks,deepinfra,groq,databricks,lambda,cerebras"

# Keys and tokens
HF_TOKEN=

# AWS/Bedrock stuff
AWS_PROFILE=

# Openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
